# Vibing Code — variables de entorno
#
# Copie este archivo como .env y ajuste los valores:
#   cp .env.example .env
#
# Vite solo expone al navegador las variables con prefijo VITE_.
# Todo lo que se exponga al navegador es público: no ponga aquí secretos
# de servidor.

# Nombre de la organización que aparece en el encabezado.
VITE_ORG_NOMBRE=NiAnd Labs

# Marca de entorno visible en el pie de página: local | pruebas | produccion
VITE_ENTORNO=local

# ─────────────────────────────────────────────────────────────
# MiniMax — obligatorio para el módulo de generación asistida
# ─────────────────────────────────────────────────────────────
# Obtenga su clave en https://www.minimax.io/platform  (API Keys).
# NUNCA versione este archivo con un valor real: .env está en .gitignore.
#
# Alternativa sin variables de entorno: deje esto vacío y pegue el token
# en Ajustes → Token dentro de la aplicación. Queda solo en su navegador.
VITE_MINIMAX_API_KEY=
VITE_MINIMAX_BASE_URL=https://api.minimax.io/v1
VITE_MINIMAX_MODEL=auto
